# Copie para .env (cp .env.exemplo .env), troque as senhas e rode: chmod 600 .env
# Nunca versionar o .env e nunca colocar YOUTUBE_API_KEY aqui: a ingestao roda so no seu computador.
# Senhas longas e diferentes entre si (openssl rand -base64 32).
VERSAO=0.1.1
POSTGRES_SENHA=troque-por-uma-senha-longa
IDIOMANDO_DB_SENHA=troque-por-outra-senha-longa
